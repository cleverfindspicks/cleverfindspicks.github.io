{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prepare-github-pages.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "intelligence:search": "node product-intelligence/search-candidates.mjs",
    "intelligence:select": "node product-intelligence/select-winner.mjs",
    "intelligence:audit": "node product-intelligence/run-current-audit.mjs",
    "intelligence:performance": "node product-intelligence/run-performance.mjs",
    "intelligence:check": "node product-intelligence/prepublish-check.mjs",
    "intelligence:test": "node product-intelligence/self-test.mjs",
    "intelligence:dry-run": "node product-intelligence/dry-run.mjs",
    "intelligence:import": "node product-intelligence/import-performance.mjs",
    "intelligence:gate": "node product-intelligence/publication-gate.mjs",
    "intelligence:automation": "node product-intelligence/automation-run.mjs",
    "intelligence:publish-approved": "node product-intelligence/publish-approved.mjs",
    "intelligence:validate": "node product-intelligence/validate-production.mjs",
    "intelligence:affiliate-audit": "node product-intelligence/audit-affiliate-destinations.mjs",
    "intelligence:affiliate-verify": "node product-intelligence/verify-provisional-destination.mjs",
    "performance:init": "node product-intelligence/import-current-catalogue.mjs",
    "performance:import:pinterest": "node product-intelligence/import-pinterest-report.mjs",
    "performance:import:site": "node product-intelligence/import-site-report.mjs",
    "performance:import:aliexpress": "node product-intelligence/import-aliexpress-report.mjs",
    "performance:sync": "node product-intelligence/sync-performance.mjs",
    "performance:recalculate": "node product-intelligence/recalculate-performance.mjs",
    "performance:report": "node product-intelligence/generate-performance-report.mjs",
    "performance:export": "node product-intelligence/export-performance.mjs",
    "performance:health": "node product-intelligence/analytics-health.mjs",
    "performance:test": "node --test product-intelligence/tests/performance.test.mjs",
    "performance:dry-run": "node product-intelligence/performance-dry-run.mjs",
    "instagram:init": "node instagram/health.mjs",
    "instagram:health": "node instagram/health.mjs --verify",
    "instagram:run": "node instagram/run.mjs",
    "instagram:dry-run": "node instagram/dry-run.mjs",
    "instagram:sync": "node instagram/sync.mjs",
    "instagram:import": "node instagram/import-metrics.mjs",
    "instagram:report": "node instagram/report.mjs",
    "instagram:connect": "node instagram/connect.mjs",
    "instagram:oauth": "node instagram/oauth-connect.mjs",
    "instagram:trial": "node instagram/run.mjs --force",
    "instagram:approve-trial": "node instagram/approve-trial.mjs",
    "instagram:test": "node --test instagram/tests/*.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "ffmpeg-static": "^5.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
